{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "App.tsx",
    "index.ts",
    "server.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src-web-backup/**",
    "node_modules",
    "dist",
    "assets"
  ]
}
