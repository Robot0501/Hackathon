# GEMINI_API_KEY: Required for Gemini AI API calls (optional, falls back to mocks).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Backend URL (used for mobile API base)
APP_URL="http://localhost:3000"

# EXPO_PUBLIC_API_URL: Mobile app API base (emulator: 10.0.2.2, physical device: LAN IP)
EXPO_PUBLIC_API_URL="http://10.0.2.2:3000"

# PORT: Backend API port
PORT="3000"

# SMTP_MAILER: Real email delivery for OTP verification.
# Copy these values into a local .env file and replace with your provider credentials.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"
