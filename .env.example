# Supabase - required for authentication, database, and storage
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-KEY"

# Express/Gemini API
# Android emulator can use 10.0.2.2 to reach the host PC.
# A physical Android phone must use the PC's LAN IP while both are on the same Wi-Fi.
EXPO_PUBLIC_API_URL="http://10.0.2.2:3000"
PORT=3000

# Optional live Gemini integration. If empty, server.ts returns fallback demo AI responses.
GEMINI_API_KEY=""
