{
  "name": "enrich-richfield-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --host lan --clear",
    "start:lan": "expo start --host lan --clear",
    "start:localhost": "expo start --host localhost --clear",
    "start:tunnel": "expo start --tunnel --clear",
    "android": "expo start --android",
    "android:dev": "expo run:android",
    "android:apk": "eas build --platform android --profile preview --local",
    "android:apk:cloud": "eas build --platform android --profile preview",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "tsx server.ts",
    "server:build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "server:start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --platform android --clean"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expo": "~57.0.22",
    "expo-av": "~16.0.7",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "express": "^4.21.2",
    "lucide-react-native": "^0.546.0",
    "nodemailer": "^10.0.9",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-refresh": "^0.14.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "~19.2.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
